# ── 모드 선택 ──────────────────────────────────────────────────────────────
# KANBAN_DB_HOST 설정 여부로 자동 분기:
#   - 미설정 → SQLite 로컬 모드 (기본값)
#   - 설정   → PostgreSQL 클라우드 모드

# ── SQLite 로컬 모드 (기본값, 별도 설정 불필요) ──────────────────────────
# KANBAN_DB_PATH=        # 기본값: 패키지 루트의 kanban.db 자동 생성

# ── PostgreSQL 클라우드 모드 ──────────────────────────────────────────────
# KANBAN_DB_HOST=<gcp-vm-외부IP>
# KANBAN_DB_PORT=5432
# KANBAN_DB_USER=ai_board_user
# KANBAN_DB_PASSWORD=<password>
# KANBAN_DB_NAME=ai_board

# ── MCP 전송 방식 ──────────────────────────────────────────────────────────
# MCP_TRANSPORT=stdio    # 기본값: stdio (Claude Desktop)
