# ── 로컬 사용자 (기본값, 별도 설정 불필요) ────────────────────────────────
# MCP_TRANSPORT=stdio        # 기본값: stdio (Claude Desktop command 방식)
# KANBAN_DB_PATH=            # 기본값: 패키지 루트의 kanban.db 자동 생성

# ── GCP 클라우드 배포용 ────────────────────────────────────────────────────
# MCP_TRANSPORT=sse
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=9010
# KANBAN_DB_PATH=/var/lib/ai-board/kanban.db
